    let currentLanguage = "ar";
    let currentStep = 1;

    const form = document.getElementById("workerApplicationForm");
    const steps = Array.from(document.querySelectorAll(".form-step"));
    const nextBtn = document.getElementById("nextBtn");
    const prevBtn = document.getElementById("prevBtn");
    const submitBtn = document.getElementById("submitBtn");
    const progressBar = document.getElementById("progressBar");
    const currentStepText = document.getElementById("currentStepText");
    const formAlert = document.getElementById("formAlert");
    const formContent = document.getElementById("formContent");
    const successScreen = document.getElementById("successScreen");

    function t(key) {
      return translations[currentLanguage][key] || key;
    }

    function applyLanguage(lang) {
      currentLanguage = lang;
      const isRtl = lang === "ar" || lang === "he";
      document.documentElement.lang = lang;
      document.documentElement.dir = isRtl ? "rtl" : "ltr";

      document.querySelectorAll("[data-i18n]").forEach((element) => {
        const key = element.dataset.i18n;
        if (translations[lang][key] !== undefined) {
          element.textContent = translations[lang][key];
        }
      });

      document.querySelectorAll("[data-i18n-html]").forEach((element) => {
        const key = element.dataset.i18nHtml;
        if (translations[lang][key] !== undefined) {
          element.innerHTML = translations[lang][key];
        }
      });

      document.querySelectorAll("[data-i18n-placeholder]").forEach((element) => {
        const key = element.dataset.i18nPlaceholder;
        if (translations[lang][key] !== undefined) {
          element.placeholder = translations[lang][key];
        }
      });

      document.querySelectorAll(".lang-btn").forEach((button) => {
        button.classList.toggle("active", button.dataset.lang === lang);
      });

      localStorage.setItem("fixshaa_worker_lang", lang);
    }

    document.querySelectorAll(".lang-btn").forEach((button) => {
      button.addEventListener("click", () => applyLanguage(button.dataset.lang));
    });

    function updateStepUI() {
      steps.forEach((step) => {
        step.classList.toggle("active", Number(step.dataset.step) === currentStep);
      });

      progressBar.style.width = `${currentStep * 25}%`;
      currentStepText.textContent = currentStep;
      prevBtn.style.visibility = currentStep === 1 ? "hidden" : "visible";
      nextBtn.style.display = currentStep === 4 ? "none" : "inline-flex";
      submitBtn.style.display = currentStep === 4 ? "inline-flex" : "none";
      hideAlert();
    }

    function hideAlert() {
      formAlert.className = "form-alert";
      formAlert.textContent = "";
    }

    function showAlert(message, type = "error") {
      formAlert.textContent = message;
      formAlert.className = `form-alert show ${type}`;
      formAlert.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    function checkedValues(name) {
      return Array.from(document.querySelectorAll(`input[name="${name}"]:checked`)).map((el) => el.value);
    }

    function radioBoolean(name, fallback = false) {
      const selected = document.querySelector(`input[name="${name}"]:checked`);
      return selected ? selected.value === "true" : fallback;
    }

    function validateNativeFields(stepElement) {
      const fields = Array.from(stepElement.querySelectorAll("input, select, textarea"));
      let firstInvalid = null;

      fields.forEach((field) => {
        field.classList.remove("invalid");

        if (!field.checkValidity()) {
          field.classList.add("invalid");
          if (!firstInvalid && !["radio", "checkbox"].includes(field.type)) {
            firstInvalid = field;
          }
        }
      });

      if (firstInvalid) {
        firstInvalid.focus();
      }

      return !fields.some((field) => !field.checkValidity());
    }

    function validateCurrentStep() {
      const stepElement = steps.find((step) => Number(step.dataset.step) === currentStep);
      const nativeValid = validateNativeFields(stepElement);

      if (!nativeValid) {
        showAlert(t("requiredMessage"));
        return false;
      }

      if (currentStep === 1) {
        const isOver18 = document.querySelector('input[name="is_over_18"]:checked');
        if (isOver18 && isOver18.value === "false") {
          showAlert(t("under18Message"));
          return false;
        }
      }

      if (currentStep === 3) {
        if (checkedValues("service_areas").length === 0) {
          showAlert(t("areaRequiredMessage"));
          return false;
        }

        if (checkedValues("available_days").length === 0) {
          showAlert(t("daysRequiredMessage"));
          return false;
        }

        if (checkedValues("available_times").length === 0) {
          showAlert(t("timesRequiredMessage"));
          return false;
        }
      }

      return true;
    }

    nextBtn.addEventListener("click", () => {
      if (!validateCurrentStep()) return;
      currentStep = Math.min(4, currentStep + 1);
      updateStepUI();
      document.getElementById("application").scrollIntoView({ behavior: "smooth", block: "start" });
    });

    prevBtn.addEventListener("click", () => {
      currentStep = Math.max(1, currentStep - 1);
      updateStepUI();
      document.getElementById("application").scrollIntoView({ behavior: "smooth", block: "start" });
    });

    function safeFileName(fileName) {
      return fileName
        .normalize("NFKD")
        .replace(/[^a-zA-Z0-9._-]/g, "-")
        .replace(/-+/g, "-")
        .toLowerCase();
    }

    function validateFiles(files) {
      if (files.length > MAX_FILES_PER_INPUT) {
        throw new Error(t("tooManyFiles"));
      }

      for (const file of files) {
        if (file.size > MAX_FILE_SIZE) {
          throw new Error(t("fileTooLarge"));
        }
      }
    }

    async function uploadFileGroup(applicationId, files, fileType) {
      const insertedRows = [];

      for (const file of files) {
        const path = `${applicationId}/${Date.now()}-${crypto.randomUUID()}-${safeFileName(file.name)}`;

        const { error: uploadError } = await supabaseClient.storage
          .from(STORAGE_BUCKET)
          .upload(path, file, {
            cacheControl: "3600",
            upsert: false,
            contentType: file.type || undefined
          });

        if (uploadError) throw uploadError;

        insertedRows.push({
          worker_application_id: applicationId,
          file_type: fileType,
          storage_path: path,
          original_file_name: file.name,
          mime_type: file.type || null,
          file_size: file.size
        });
      }

      if (insertedRows.length > 0) {
        const { error: metadataError } = await supabaseClient
          .from("worker_application_files")
          .insert(insertedRows);

        if (metadataError) throw metadataError;
      }
    }

    function nullableNumber(value) {
      return value === "" || value === null ? null : Number(value);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      hideAlert();

      if (!validateCurrentStep()) return;

      if (document.getElementById("website").value.trim() !== "") {
        return;
      }

      if (SUPABASE_ANON_KEY.includes("PASTE_YOUR")) {
        showAlert(t("configError"));
        return;
      }

      const portfolioFiles = Array.from(document.getElementById("portfolio_files").files || []);
      const certificateFiles = Array.from(document.getElementById("certificate_files").files || []);

      try {
        validateFiles(portfolioFiles);
        validateFiles(certificateFiles);
      } catch (error) {
        showAlert(error.message);
        return;
      }

      submitBtn.disabled = true;
      const originalSubmitText = submitBtn.textContent;
      submitBtn.textContent = t("sending");

      const serviceAreas = checkedValues("service_areas");
      const otherArea = document.getElementById("other_service_area").value.trim();
      if (otherArea) serviceAreas.push(otherArea);

      const applicationId = crypto.randomUUID();

      const payload = {
        id: applicationId,
        full_name: document.getElementById("full_name").value.trim(),
        phone: document.getElementById("phone").value.trim(),
        email: document.getElementById("email").value.trim() || null,
        city: document.getElementById("city").value.trim(),
        is_over_18: radioBoolean("is_over_18"),
        preferred_language: document.getElementById("preferred_language").value,
        primary_profession: document.getElementById("primary_profession").value,
        additional_professions: checkedValues("additional_professions"),
        years_of_experience: nullableNumber(document.getElementById("years_of_experience").value),
        experience_description: document.getElementById("experience_description").value.trim() || null,
        worked_independently: radioBoolean("worked_independently"),
        can_provide_references: radioBoolean("can_provide_references"),
        service_areas: serviceAreas,
        has_driver_license: radioBoolean("has_driver_license"),
        has_vehicle: radioBoolean("has_vehicle"),
        has_tools: radioBoolean("has_tools"),
        maximum_travel_distance_km: nullableNumber(document.getElementById("maximum_travel_distance_km").value),
        available_days: checkedValues("available_days"),
        available_times: checkedValues("available_times"),
        accepts_emergency_jobs: radioBoolean("accepts_emergency_jobs"),
        accepts_night_jobs: radioBoolean("accepts_night_jobs"),
        expected_hourly_rate: nullableNumber(document.getElementById("expected_hourly_rate").value),
        business_status: document.getElementById("business_status").value || null,
        can_issue_invoice: radioBoolean("can_issue_invoice"),
        portfolio_url: document.getElementById("portfolio_url").value.trim() || null,
        motivation: document.getElementById("motivation").value.trim() || null,
        source: document.getElementById("source").value || "worker_landing_page",
        agrees_to_verification: document.getElementById("agrees_to_verification").checked,
        agrees_to_privacy_policy: document.getElementById("agrees_to_privacy_policy").checked,
        agrees_to_terms: document.getElementById("agrees_to_terms").checked,
        status: "new"
      };

      try {
        const { error } = await supabaseClient
          .from("worker_applications")
          .insert(payload);

        if (error) throw error;

        let uploadWarning = false;

        try {
          if (portfolioFiles.length) {
            await uploadFileGroup(applicationId, portfolioFiles, "portfolio_image");
          }

          if (certificateFiles.length) {
            await uploadFileGroup(applicationId, certificateFiles, "certificate");
          }
        } catch (uploadError) {
          console.error("File upload error:", uploadError);
          uploadWarning = true;
        }

        if (uploadWarning) {
          formContent.style.display = "none";
          successScreen.classList.add("show");
          const successParagraph = successScreen.querySelector("p");
          successParagraph.textContent = `${t("successCopy")} ${t("uploadWarning")}`;
        } else {
          formContent.style.display = "none";
          successScreen.classList.add("show");
          successScreen.querySelector("p").textContent = t("successCopy");
        }

        successScreen.scrollIntoView({ behavior: "smooth", block: "center" });
      } catch (error) {
        console.error("Submission error:", error);
        showAlert(t("submitError"));
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalSubmitText;
      }
    });

    document.getElementById("newApplicationBtn").addEventListener("click", () => {
      form.reset();
      currentStep = 1;
      updateStepUI();
      successScreen.classList.remove("show");
      formContent.style.display = "block";
      document.getElementById("application").scrollIntoView({ behavior: "smooth", block: "start" });
    });

    document.querySelectorAll("input, select, textarea").forEach((field) => {
      field.addEventListener("input", () => field.classList.remove("invalid"));
      field.addEventListener("change", () => field.classList.remove("invalid"));
    });

    document.getElementById("currentYear").textContent = new Date().getFullYear();
    applyLanguage(localStorage.getItem("fixshaa_worker_lang") || "ar");
    updateStepUI();
  </script>
