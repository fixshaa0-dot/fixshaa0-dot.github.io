<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="انضم إلى شبكة المهنيين في FixSha’a وسجّل طلبك للعمل بمرونة وشفافية." />
  <title>انضم كمهني | FixSha’a</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Heebo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root {
      --navy: #061b33;
      --navy-2: #0b2b4d;
      --turquoise: #00c7d9;
      --turquoise-dark: #00aab9;
      --turquoise-soft: #e7fbfd;
      --off-white: #f8fbfc;
      --white: #ffffff;
      --text: #102238;
      --muted: #64748b;
      --line: #dbe7ec;
      --success: #0f9f6e;
      --danger: #dc3545;
      --warning: #f5a524;
      --shadow: 0 24px 70px rgba(6, 27, 51, 0.12);
      --radius-xl: 30px;
      --radius-lg: 22px;
      --radius-md: 16px;
      --radius-sm: 12px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: "Cairo", "Heebo", Arial, sans-serif;
      color: var(--text);
      background: var(--off-white);
      line-height: 1.7;
    }

    html[lang="he"] body,
    html[lang="en"] body {
      font-family: "Heebo", "Cairo", Arial, sans-serif;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    img {
      max-width: 100%;
    }

    .container {
      width: min(1180px, calc(100% - 34px));
      margin-inline: auto;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(248, 251, 252, 0.92);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(219, 231, 236, 0.8);
    }

    .header-inner {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      font-weight: 800;
      color: var(--navy);
      letter-spacing: -0.02em;
    }

    .brand-mark {
      width: 46px;
      height: 46px;
      border-radius: 15px;
      display: grid;
      place-items: center;
      background: var(--navy);
      color: var(--turquoise);
      box-shadow: 0 10px 22px rgba(6, 27, 51, 0.16);
      font-size: 23px;
      font-weight: 800;
      position: relative;
      overflow: hidden;
    }

    .brand-mark::after {
      content: "";
      position: absolute;
      width: 18px;
      height: 18px;
      border: 3px solid var(--white);
      border-radius: 50%;
      inset-inline-end: 5px;
      bottom: 5px;
      opacity: 0.95;
    }

    .brand-mark span {
      position: relative;
      z-index: 1;
      transform: translateY(-2px);
    }

    .brand-name {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }

    .brand-name strong {
      font-size: 20px;
    }

    .brand-name small {
      margin-top: 5px;
      font-size: 11px;
      color: var(--muted);
      font-weight: 600;
    }

    .header-nav {
      display: flex;
      align-items: center;
      gap: 22px;
      font-size: 14px;
      font-weight: 700;
      color: #38516b;
    }

    .header-nav a:hover {
      color: var(--turquoise-dark);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .language-switcher {
      display: flex;
      gap: 4px;
      padding: 4px;
      border: 1px solid var(--line);
      background: var(--white);
      border-radius: 999px;
    }

    .lang-btn {
      border: 0;
      background: transparent;
      color: var(--muted);
      border-radius: 999px;
      min-width: 42px;
      height: 34px;
      padding: 0 10px;
      font-weight: 800;
      font-size: 12px;
    }

    .lang-btn.active {
      background: var(--navy);
      color: var(--white);
    }

    .primary-btn,
    .secondary-btn,
    .ghost-btn {
      border-radius: 14px;
      border: 0;
      padding: 13px 22px;
      font-weight: 800;
      transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .primary-btn {
      background: var(--turquoise);
      color: var(--navy);
      box-shadow: 0 14px 30px rgba(0, 199, 217, 0.25);
    }

    .primary-btn:hover {
      transform: translateY(-2px);
      background: #13d3e2;
    }

    .secondary-btn {
      background: var(--navy);
      color: var(--white);
      box-shadow: 0 14px 30px rgba(6, 27, 51, 0.18);
    }

    .secondary-btn:hover {
      transform: translateY(-2px);
      background: var(--navy-2);
    }

    .ghost-btn {
      background: #eef5f7;
      color: var(--navy);
    }

    .hero {
      position: relative;
      overflow: hidden;
      padding: 78px 0 64px;
      background:
        radial-gradient(circle at 12% 20%, rgba(0, 199, 217, 0.14), transparent 34%),
        radial-gradient(circle at 90% 12%, rgba(0, 199, 217, 0.1), transparent 28%),
        linear-gradient(180deg, #ffffff 0%, #f4fafb 100%);
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 420px;
      height: 420px;
      border: 1px solid rgba(0, 199, 217, 0.15);
      border-radius: 50%;
      left: -180px;
      top: -130px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 54px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 13px;
      border-radius: 999px;
      background: var(--turquoise-soft);
      color: #087f8a;
      font-size: 13px;
      font-weight: 800;
      margin-bottom: 20px;
    }

    .eyebrow-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--turquoise);
      box-shadow: 0 0 0 5px rgba(0, 199, 217, 0.14);
    }

    h1,
    h2,
    h3,
    p {
      margin-top: 0;
    }

    h1 {
      margin-bottom: 22px;
      color: var(--navy);
      font-size: clamp(42px, 6vw, 72px);
      line-height: 1.08;
      letter-spacing: -0.045em;
    }

    .hero-highlight {
      color: var(--turquoise-dark);
    }

    .hero-copy {
      max-width: 690px;
      color: #4b6077;
      font-size: 18px;
      margin-bottom: 28px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 28px;
    }

    .trust-row {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      color: #4b6077;
      font-size: 14px;
      font-weight: 700;
    }

    .trust-item {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .check-icon {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: #dff8ee;
      color: var(--success);
      font-weight: 900;
      font-size: 13px;
    }

    .hero-card {
      background: var(--navy);
      color: var(--white);
      border-radius: var(--radius-xl);
      padding: 28px;
      box-shadow: var(--shadow);
      position: relative;
      overflow: hidden;
    }

    .hero-card::after {
      content: "";
      position: absolute;
      width: 260px;
      height: 260px;
      border-radius: 50%;
      background: rgba(0, 199, 217, 0.12);
      inset-inline-end: -110px;
      bottom: -120px;
    }

    .mock-phone {
      position: relative;
      z-index: 1;
      padding: 21px;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .mock-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 22px;
    }

    .mock-title {
      font-weight: 800;
      font-size: 17px;
    }

    .status-pill {
      padding: 6px 10px;
      border-radius: 999px;
      background: rgba(0, 199, 217, 0.18);
      color: #8af4fd;
      font-size: 11px;
      font-weight: 800;
    }

    .job-card {
      background: var(--white);
      color: var(--text);
      border-radius: 20px;
      padding: 20px;
      margin-bottom: 14px;
    }

    .job-card:last-child {
      margin-bottom: 0;
    }

    .job-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }

    .job-icon {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background: var(--turquoise-soft);
      font-size: 23px;
    }

    .job-meta {
      flex: 1;
    }

    .job-meta strong {
      display: block;
      color: var(--navy);
      font-size: 15px;
    }

    .job-meta span {
      font-size: 12px;
      color: var(--muted);
    }

    .job-price {
      color: var(--turquoise-dark);
      font-weight: 800;
      white-space: nowrap;
    }

    .job-details {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 14px;
    }

    .mini-pill {
      background: #f0f5f7;
      color: #52677c;
      border-radius: 999px;
      padding: 5px 9px;
      font-size: 11px;
      font-weight: 700;
    }

    .mock-action {
      width: 100%;
      border: 0;
      border-radius: 12px;
      padding: 11px;
      background: var(--turquoise);
      color: var(--navy);
      font-weight: 800;
    }

    .section {
      padding: 86px 0;
    }

    .section-header {
      max-width: 730px;
      margin: 0 auto 46px;
      text-align: center;
    }

    .section-header h2 {
      color: var(--navy);
      font-size: clamp(31px, 4vw, 48px);
      line-height: 1.2;
      letter-spacing: -0.035em;
      margin-bottom: 14px;
    }

    .section-header p {
      color: var(--muted);
      font-size: 17px;
    }

    .steps-grid,
    .benefits-grid,
    .requirements-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .step-card,
    .benefit-card,
    .requirement-card {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 24px;
      box-shadow: 0 14px 36px rgba(6, 27, 51, 0.06);
    }

    .step-number {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background: var(--navy);
      color: var(--turquoise);
      font-weight: 900;
      margin-bottom: 20px;
    }

    .step-card h3,
    .benefit-card h3,
    .requirement-card h3 {
      color: var(--navy);
      font-size: 18px;
      margin-bottom: 8px;
    }

    .step-card p,
    .benefit-card p,
    .requirement-card p {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 0;
    }

    .benefits-section {
      background: var(--navy);
      position: relative;
      overflow: hidden;
    }

    .benefits-section .section-header h2,
    .benefits-section .section-header p {
      color: var(--white);
    }

    .benefits-section .section-header p {
      opacity: 0.72;
    }

    .benefits-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .benefit-card {
      border-color: rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.07);
      box-shadow: none;
      color: var(--white);
    }

    .benefit-icon {
      width: 48px;
      height: 48px;
      border-radius: 15px;
      display: grid;
      place-items: center;
      background: rgba(0, 199, 217, 0.15);
      color: var(--turquoise);
      font-size: 24px;
      margin-bottom: 18px;
    }

    .benefit-card h3 {
      color: var(--white);
    }

    .benefit-card p {
      color: rgba(255, 255, 255, 0.7);
    }

    .requirements-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .requirement-card {
      display: flex;
      align-items: flex-start;
      gap: 14px;
    }

    .requirement-check {
      flex: 0 0 auto;
      width: 30px;
      height: 30px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      background: var(--turquoise-soft);
      color: var(--turquoise-dark);
      font-weight: 900;
    }

    .application-section {
      padding-top: 40px;
      background:
        linear-gradient(180deg, var(--off-white) 0%, #ffffff 100%);
    }

    .form-shell {
      max-width: 940px;
      margin: 0 auto;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .form-top {
      padding: 28px 32px 24px;
      background: linear-gradient(135deg, var(--navy), #0b3158);
      color: var(--white);
    }

    .form-top-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 22px;
    }

    .form-top h2 {
      margin-bottom: 6px;
      font-size: 28px;
    }

    .form-top p {
      margin-bottom: 0;
      color: rgba(255, 255, 255, 0.72);
      font-size: 14px;
    }

    .step-counter {
      flex: 0 0 auto;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.09);
      padding: 7px 12px;
      font-size: 12px;
      font-weight: 800;
    }

    .progress-track {
      height: 8px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.12);
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      width: 25%;
      background: var(--turquoise);
      border-radius: inherit;
      transition: width 0.3s ease;
    }

    .form-body {
      padding: 34px 32px 30px;
    }

    .form-step {
      display: none;
      animation: fadeUp 0.32s ease;
    }

    .form-step.active {
      display: block;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .step-heading {
      margin-bottom: 26px;
    }

    .step-heading h3 {
      color: var(--navy);
      font-size: 24px;
      margin-bottom: 6px;
    }

    .step-heading p {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 0;
    }

    .field-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    .field label,
    .field legend {
      color: var(--navy);
      font-weight: 800;
      font-size: 14px;
    }

    .required::after {
      content: " *";
      color: var(--danger);
    }

    input[type="text"],
    input[type="tel"],
    input[type="email"],
    input[type="number"],
    input[type="url"],
    select,
    textarea {
      width: 100%;
      border: 1px solid #cfdde3;
      border-radius: 13px;
      background: #fbfdfe;
      color: var(--text);
      padding: 13px 14px;
      outline: none;
      transition: border 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    textarea {
      min-height: 118px;
      resize: vertical;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--turquoise);
      background: var(--white);
      box-shadow: 0 0 0 4px rgba(0, 199, 217, 0.12);
    }

    input.invalid,
    select.invalid,
    textarea.invalid {
      border-color: var(--danger);
      box-shadow: 0 0 0 4px rgba(220, 53, 69, 0.08);
    }

    .hint {
      color: var(--muted);
      font-size: 12px;
      margin-top: -2px;
    }

    .choice-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }

    .choice-grid.two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .choice-card {
      position: relative;
      display: flex;
      align-items: center;
      gap: 9px;
      border: 1px solid #d5e2e7;
      border-radius: 13px;
      padding: 12px 13px;
      background: #fbfdfe;
      cursor: pointer;
      color: #40566d;
      font-size: 13px;
      font-weight: 700;
      transition: border 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }

    .choice-card:hover {
      transform: translateY(-1px);
      border-color: #9fdde4;
    }

    .choice-card input {
      accent-color: var(--turquoise-dark);
      width: 17px;
      height: 17px;
      flex: 0 0 auto;
    }

    .choice-card:has(input:checked) {
      border-color: var(--turquoise);
      background: var(--turquoise-soft);
      color: var(--navy);
    }

    .yes-no {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .upload-box {
      border: 1.5px dashed #9fb8c4;
      border-radius: 16px;
      padding: 22px;
      background: #f8fcfd;
      text-align: center;
    }

    .upload-box input[type="file"] {
      width: 100%;
      margin-top: 12px;
    }

    .upload-icon {
      font-size: 30px;
      margin-bottom: 8px;
    }

    .consent-list {
      display: grid;
      gap: 11px;
    }

    .consent-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      border: 1px solid var(--line);
      border-radius: 13px;
      padding: 13px;
      background: #fbfdfe;
      font-size: 13px;
      color: #40566d;
    }

    .consent-item input {
      margin-top: 4px;
      accent-color: var(--turquoise-dark);
      width: 17px;
      height: 17px;
      flex: 0 0 auto;
    }

    .form-alert {
      display: none;
      margin: 0 32px 22px;
      border-radius: 14px;
      padding: 13px 15px;
      font-size: 13px;
      font-weight: 700;
    }

    .form-alert.show {
      display: block;
    }

    .form-alert.error {
      background: #fff0f2;
      color: #b72b3a;
      border: 1px solid #f4c2c8;
    }

    .form-alert.success {
      background: #eafbf4;
      color: #087650;
      border: 1px solid #b6e8d2;
    }

    .form-navigation {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 28px;
      padding-top: 22px;
      border-top: 1px solid var(--line);
    }

    .nav-spacer {
      flex: 1;
    }

    .submit-btn[disabled],
    .next-btn[disabled] {
      opacity: 0.65;
      cursor: not-allowed;
      transform: none;
    }

    .success-screen {
      display: none;
      padding: 52px 30px 58px;
      text-align: center;
    }

    .success-screen.show {
      display: block;
    }

    .success-badge {
      width: 82px;
      height: 82px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      margin: 0 auto 22px;
      background: #dff8ee;
      color: var(--success);
      font-size: 38px;
      font-weight: 900;
    }

    .success-screen h3 {
      color: var(--navy);
      font-size: 30px;
      margin-bottom: 10px;
    }

    .success-screen p {
      max-width: 560px;
      margin: 0 auto 24px;
      color: var(--muted);
    }

    .privacy-note {
      max-width: 860px;
      margin: 22px auto 0;
      text-align: center;
      color: var(--muted);
      font-size: 12px;
    }

    .site-footer {
      margin-top: 86px;
      background: #041426;
      color: var(--white);
      padding: 34px 0;
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .footer-inner p {
      margin: 0;
      color: rgba(255, 255, 255, 0.6);
      font-size: 13px;
    }

    .footer-links {
      display: flex;
      gap: 18px;
      color: rgba(255, 255, 255, 0.75);
      font-size: 13px;
      font-weight: 700;
    }

    .hidden-honeypot {
      position: absolute;
      left: -9999px;
      opacity: 0;
      pointer-events: none;
    }

    @media (max-width: 980px) {
      .header-nav {
        display: none;
      }

      .hero-grid {
        grid-template-columns: 1fr;
      }

      .hero-card {
        max-width: 680px;
      }

      .steps-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .benefits-grid,
      .requirements-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

